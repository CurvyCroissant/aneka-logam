---
import { copy } from '../i18n/copy';
import type { Locale } from '../i18n/routes';
interface Props { locale: Locale; items: { label: string; href?: string }[] }
const { locale, items } = Astro.props;
---
<nav class="breadcrumbs" aria-label={copy(locale).breadcrumbs}>
  <ol>
    {items.map(({ label, href }, index) => (
      <li>
        {index > 0 && <span class="breadcrumb-separator" aria-hidden="true">/</span>}
        {href ? <a href={href}>{label}</a> : <span aria-current="page">{label}</span>}
      </li>
    ))}
  </ol>
</nav>
