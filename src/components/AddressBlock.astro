---
import { addressLines, directionsUrl } from '../config/navigation';
import { storefrontPhotos } from '../config/media';
import { copy } from '../i18n/copy';
import type { Locale } from '../i18n/routes';
import Arrow from './Arrow.astro';
import MediaGallery from './MediaGallery.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = copy(locale);
---
<div class="address-panel" data-reveal>
  <MediaGallery id="storefront" images={storefrontPhotos} kind="store" locale={locale} />
  <div class="address-copy">
    <h3 data-i18n="address">{t.address}</h3>
    <address lang="id">{addressLines.map((line) => <span>{line}</span>)}</address>
    <a class="text-link" href={directionsUrl} target="_blank" rel="noopener noreferrer" aria-describedby="new-tab-note"><span data-i18n="directions">{t.directions}</span><Arrow /></a>
  </div>
</div>
