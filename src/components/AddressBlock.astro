---
import { company } from '../config/company';
import { addressLines, directionsUrl } from '../config/navigation';
import { copy } from '../i18n/copy';
import type { Locale } from '../i18n/routes';
import Arrow from './Arrow.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = copy(locale);
---
<div class="address-panel" data-reveal>
  <h3>{t.address}</h3>
  <address lang="id">{addressLines.map((line) => <span>{line}</span>)}</address>
  <a class="text-link" href={directionsUrl}>{t.directions}<Arrow /></a>
  <div class="people">
    <h3>{t.people}</h3>
    <p>{company.people.join(' · ')}</p>
  </div>
</div>
