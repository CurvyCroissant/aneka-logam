---
import { addressLines, directionsUrl } from '../config/navigation';
import { copy } from '../i18n/copy';
import type { Locale } from '../i18n/routes';
import Arrow from './Arrow.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = copy(locale);
---
<section class="address-panel" aria-labelledby="address-heading">
  <p class="eyebrow">Metro Glodok</p>
  <h2 id="address-heading">{t.address}</h2>
  <address lang="id">{addressLines.map((line) => <span>{line}</span>)}</address>
  <a class="text-link" href={directionsUrl}>{t.directions}<Arrow /></a>
</section>
