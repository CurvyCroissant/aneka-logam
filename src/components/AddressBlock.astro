---
import { storefrontPhotos } from '../config/media';
import { copy } from '../i18n/copy';
import type { Locale } from '../i18n/routes';
import AddressLink from './AddressLink.astro';
import MediaGallery from './MediaGallery.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = copy(locale);
---
<div class="address-panel" data-reveal>
  <MediaGallery id="storefront" images={storefrontPhotos} kind="store" locale={locale} />
  <div class="address-copy">
    <h3><span data-i18n="address" data-i18n-size>{t.address}</span></h3>
    <AddressLink locale={locale} />
  </div>
</div>
