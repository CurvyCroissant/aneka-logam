---
import { Image } from 'astro:assets';
import logo from '../assets/aneka-logam-logo.jpg';
import { company } from '../config/company';
import { navigation } from '../config/navigation';
import { copy } from '../i18n/copy';
import { pagePath, type Locale, type LocalizedPaths } from '../i18n/routes';
interface Props { locale: Locale; paths: LocalizedPaths }
const { locale, paths } = Astro.props;
const t = copy(locale);
const isHome = Astro.url.pathname === pagePath(locale, 'home');
---
<header class="site-header">
  <div class="container header-inner">
    <a class="wordmark" href={isHome ? '#home' : pagePath(locale, 'home')} aria-label={`${company.name} — ${t.home}`}>
      <Image src={logo} alt="" width={56} height={56} widths={[56, 112]} sizes="56px" layout="none" format="webp" loading="eager" class="logo-mark" />
      <span class="brand-name">{company.displayName}</span>
    </a>
    <nav class="primary-navigation" aria-label={t.mainNavigation}>
      <ul class="nav-links">
        {navigation(locale).map(({ id, label, href }) => (
          <li><a href={isHome ? `#${id}` : href} data-section-link={id} aria-current={isHome && id === 'home' ? 'location' : undefined}>{label}</a></li>
        ))}
      </ul>
    </nav>
    <nav class="language-switch" aria-label={t.languageNavigation}>
      <a href={paths.id} hreflang="id" lang="id" data-language-link aria-label="Bahasa Indonesia" aria-current={locale === 'id' ? 'true' : undefined}>ID</a>
      <a href={paths.en} hreflang="en" lang="en" data-language-link aria-label="English" aria-current={locale === 'en' ? 'true' : undefined}>EN</a>
    </nav>
  </div>
</header>
