---
import ZoomImage from './ZoomImage.astro';
import logo from '../assets/logo-no-bg.png';
import { company } from '../config/company';
import { navigation } from '../config/navigation';
import { copy } from '../i18n/copy';
import { pagePath, type Locale, type LocalizedPaths } from '../i18n/routes';
interface Props { locale: Locale; paths: LocalizedPaths }
const { locale, paths } = Astro.props;
const t = copy(locale);
const isHome = Astro.url.pathname === pagePath(locale, 'home');
---
<header class="site-header">
  <div class="container header-inner" data-reveal>
    <div class="wordmark">
      <ZoomImage src={logo} alt={`Logo ${company.name}`} locale={locale} width={64} height={64} widths={[64, 128]} sizes="48px" loading="eager" class="logo-mark" />
      <a class="brand-name" href={isHome ? '#home' : pagePath(locale, 'home')} aria-label={`${company.name} — Home`}>{company.displayName}</a>
    </div>
    <nav class="primary-navigation" aria-label={t.mainNavigation}>
      <ul class="nav-links">
        {navigation(locale).map(({ id, label, href }) => (
          <li><a lang="en" href={isHome ? `#${id}` : href} data-section-link={id} aria-current={isHome && id === 'home' ? 'location' : undefined}><span>{label}</span></a></li>
        ))}
      </ul>
    </nav>
    <nav class="language-switch" aria-label={t.languageNavigation}>
      {(['id', 'en'] as const).map((language) => (
        <a href={paths[language]} hreflang={language} lang={language} data-language-link aria-label={language === 'id' ? 'Bahasa Indonesia' : 'English'} aria-current={locale === language ? 'true' : undefined}>{language.toUpperCase()}</a>
      ))}
    </nav>
  </div>
</header>
