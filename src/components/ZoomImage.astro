---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { copy } from '../i18n/copy';
import type { Locale } from '../i18n/routes';

interface Props {
  src: ImageMetadata;
  alt: string;
  locale: Locale;
  widths: number[];
  sizes: string;
  width?: number;
  height?: number;
  loading?: 'eager' | 'lazy';
  class?: string;
}
const { src, alt, locale, widths, sizes, width = src.width, height = src.height, loading = 'lazy', class: className = '' } = Astro.props;
const fullImage = await getImage({ src, width: Math.min(1600, src.width), format: 'webp', quality: 82 });
---
<a class={`image-trigger ${className}`} href={fullImage.src} data-image-trigger data-image-width={src.width} data-image-height={src.height} aria-label={`${copy(locale).enlargeImage}: ${alt}`} aria-haspopup="dialog" aria-controls="image-viewer">
  <Image src={src} alt={alt} width={width} height={height} widths={widths} sizes={sizes} layout="none" format="webp" loading={loading} data-image-content />
</a>
