---
import { copy } from '../i18n/copy';
import type { Locale } from '../i18n/routes';
import Breadcrumbs from './Breadcrumbs.astro';
interface Props { locale: Locale; title: string; intro: string; items: { label: string; href?: string }[] }
const { locale, title, intro, items } = Astro.props;
---
<section class="page-banner">
  <div class="container">
    <Breadcrumbs locale={locale} items={items} />
    <p class="eyebrow">{copy(locale).industry}</p>
    <h1>{title}</h1>
    <p class="lead">{intro}</p>
  </div>
</section>
