---
import { company } from '../config/company';
import { copy } from '../i18n/copy';
import type { Locale } from '../i18n/routes';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = copy(locale);
---
<ul class="product-grid">
  {company.products.map((product) => (
    <li id={product.id} class="product-card" data-reveal>
      <h3 lang="en">{product.name}</h3>
      <p>{product.summary[locale]}</p>
      <details class="product-details">
        <summary><span>{t.detailsHeading}</span><span class="details-mark" aria-hidden="true">+</span></summary>
        <ul class="enquiry-list">{product.enquiryDetails[locale].map((line) => <li>{line}</li>)}</ul>
      </details>
    </li>
  ))}
</ul>
