---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { copy } from '../../i18n/copy';
import { pagePath, pagePaths, type Locale } from '../../i18n/routes';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = copy(locale);
---
<BaseLayout locale={locale} title={t.notFoundTitle} description={t.notFoundMessage} paths={pagePaths('home')} noindex>
  <section class="section error-section"><div class="container" data-reveal>
    <p class="error-code">404</p><h1 data-font-text>{t.notFound}</h1><p class="lead">{t.notFoundMessage}</p>
    <a tabindex="0" class="button" href={pagePath(locale, 'home')}>{t.backHome}</a>
  </div></section>
</BaseLayout>
