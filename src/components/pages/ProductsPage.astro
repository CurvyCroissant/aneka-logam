---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { company } from '../../config/company';
import { copy } from '../../i18n/copy';
import { pagePaths, type Locale } from '../../i18n/routes';
import ProductList from '../ProductList.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = copy(locale);
---
<BaseLayout locale={locale} page="products" title={t.productsTitle} description={t.catalogDescription} paths={pagePaths('products')}>
  <section id="products" class="section catalog-products" data-product-catalog aria-labelledby="catalog-heading" tabindex="-1">
    <div class="container">
      <div class="section-heading" data-reveal><h1 id="catalog-heading" lang="en" data-font-text>Products</h1><span class="section-rule" aria-hidden="true"></span></div>
      <div class="catalog-navigation" role="group" aria-label={t.productCategories} data-i18n-aria-label="productCategories" data-product-filters hidden>
        <button type="button" tabindex="0" data-product-filter="all" aria-pressed="true" aria-controls="product-list"><span data-i18n="allProducts">{t.allProducts}</span><span class="category-count" aria-hidden="true">{company.products.length}</span></button>
        {company.categories.map((category) => <button type="button" tabindex="0" data-product-filter={category.id} aria-pressed="false" aria-controls="product-list"><span>{category.name}</span><span class="category-count" aria-hidden="true">{company.products.filter((product) => product.category === category.id).length}</span></button>)}
      </div>
      <div class="catalog-viewport" data-catalog-viewport><ProductList locale={locale} /></div>
    </div>
  </section>
</BaseLayout>
