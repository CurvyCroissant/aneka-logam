---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { hasContactDetails } from '../../config/navigation';
import { copy } from '../../i18n/copy';
import { pagePath, pagePaths, type Locale } from '../../i18n/routes';
import PageBanner from '../PageBanner.astro';
import ProductList from '../ProductList.astro';
import Arrow from '../Arrow.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = copy(locale);
---
<BaseLayout locale={locale} title={t.productsTitle} description={t.productsDescription} paths={pagePaths('products')}>
  <PageBanner locale={locale} title={t.products} intro={t.productsIntro} items={[{label:t.home,href:pagePath(locale,'home')},{label:t.products}]} />
  <section class="section" aria-labelledby="categories-heading">
    <div class="container">
      <h2 id="categories-heading">{t.categories}</h2>
      <ProductList locale={locale} />
      <p class="notice">{t.rangeNote}</p>
      {hasContactDetails && <a class="button" href={pagePath(locale,'contact')}>{t.enquiryAction}<Arrow /></a>}
    </div>
  </section>
</BaseLayout>
