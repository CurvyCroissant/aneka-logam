---
import { company } from '../config/company';
import { copy } from '../i18n/copy';
import { categoryPath, type Locale } from '../i18n/routes';
import ProductSketch from './ProductSketch.astro';
import Arrow from './Arrow.astro';
import CarouselControls from './CarouselControls.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = copy(locale);
---
<div class="category-carousel" data-category-carousel data-reveal>
  <ul id="category-carousel-track" class="category-track" data-category-track data-gallery-track aria-label={t.productCategories} data-i18n-aria-label="productCategories">
    {company.categories.map((category) => (
      <li class="category-card" data-category-card>
        <a class="category-card-link" tabindex="0" href={categoryPath(locale, category)} data-category-destination={category.id}>
          <div class="category-visual" aria-hidden="true"><ProductSketch kind={category.imageKind} /></div>
          <div class="category-copy">
            <h3>{category.name}</h3>
            <p data-i18n={`category.${category.key}.summary`}>{category.summary[locale]}</p>
            <span class="category-prompt"><span data-i18n="viewCategory" data-i18n-size>{t.viewCategory}</span><Arrow /></span>
          </div>
        </a>
      </li>
    ))}
  </ul>
  <CarouselControls id="home-carousel-controls" trackId="category-carousel-track" count={company.categories.length} locale={locale} />
</div>
