---
import { company } from '../config/company';
import { navigation, contactMethods } from '../config/navigation';
import { copy } from '../i18n/copy';
import type { Locale } from '../i18n/routes';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = copy(locale);
---
<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <p class="brand-name">{company.displayName}</p>
      <p class="store-phrase" lang="en">{company.phrase}</p>
    </div>
    <nav aria-label={t.footerNavigation}>
      <ul class="footer-links">
        {navigation(locale).map(({ label, href }) => <li><a href={href}>{label}</a></li>)}
      </ul>
    </nav>
    <div>
      <p class="footer-label">{t.contactMethods}</p>
      <ul class="footer-links contact-footer">
        {contactMethods.map(({ kind, value, href }) => (
          <li><a href={href}>{kind === 'whatsapp' ? 'WhatsApp' : value}</a></li>
        ))}
      </ul>
    </div>
  </div>
  <div class="container footer-bottom">
    <small>&copy; {new Date().getFullYear()} {company.name}</small>
    <small>Metro Glodok · Jakarta Pusat</small>
  </div>
</footer>
