---
import { company } from '../config/company';
import { contactMethods } from '../config/navigation';
import { copy } from '../i18n/copy';
import { pagePath, type Locale } from '../i18n/routes';
import ContactAction from './ContactAction.astro';
import AddressLink from './AddressLink.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = copy(locale);
---
<footer class="site-footer" data-reveal>
  <div class="container footer-inner">
    <nav class="footer-navigation" aria-label={t.pageNavigation} data-i18n-aria-label="pageNavigation">
      <ul class="nav-links">
        {(['home', 'products'] as const).map((page) => <li><a tabindex="0" lang="en" href={pagePath(locale, page)} data-page-link={page} aria-current={Astro.url.pathname === pagePath(locale, page) ? 'page' : undefined}><span>{t[page]}</span></a></li>)}
      </ul>
    </nav>
    <section class="footer-contact" aria-label={t.contact}>
      <ul class="footer-contacts">{contactMethods.map((method) => <li><ContactAction method={method} locale={locale} /></li>)}</ul>
    </section>
    <section class="footer-address" aria-label={t.address} data-i18n-aria-label="address">
      <AddressLink locale={locale} />
    </section>
    <small class="copyright">&copy; {new Date().getFullYear()} {company.name}</small>
  </div>
</footer>
