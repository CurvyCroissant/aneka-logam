---
import { company } from '../config/company';
import { contactMethods } from '../config/navigation';
import { copy } from '../i18n/copy';
import type { Locale } from '../i18n/routes';
import ContactAction from './ContactAction.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = copy(locale);
---
<footer class="site-footer">
  <div class="container footer-inner">
    <ul class="footer-contacts" aria-label={t.contactMethods}>
      {contactMethods.map((method) => <li><ContactAction method={method} locale={locale} /></li>)}
    </ul>
    <small class="copyright">&copy; {new Date().getFullYear()} {company.name}</small>
  </div>
</footer>
