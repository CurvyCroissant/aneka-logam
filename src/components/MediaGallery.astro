---
import ZoomImage from './ZoomImage.astro';
import type { SitePhoto } from '../config/media';
import { copy } from '../i18n/copy';
import type { Locale } from '../i18n/routes';
import Arrow from './Arrow.astro';
import MediaPlaceholder from './MediaPlaceholder.astro';
interface Props { id: string; images: readonly SitePhoto[]; kind: 'shimPlate' | 'spring' | 'store'; locale: Locale }
const { id, images, kind, locale } = Astro.props;
const t = copy(locale);
const label = kind === 'store' ? t.storePhotos : t.productPhotos;
---
<div class={`media-gallery ${kind === 'store' ? 'store-gallery' : 'product-gallery'}`} data-gallery={id}>
  {images.length ? (
    <>
      <div class="gallery-track" id={`${id}-track`} data-gallery-track tabindex={images.length > 1 ? 0 : undefined} role="region" aria-label={label} data-i18n-aria-label={kind === 'store' ? 'storePhotos' : 'productPhotos'}>
        {images.map((photo, index) => (
          <figure class="gallery-slide" aria-label={`${index + 1} / ${images.length}`}>
            <ZoomImage src={photo.src} alt={photo.alt[locale]} altTexts={photo.alt} locale={locale} widths={[360, 720, 1080]} sizes="(min-width: 80rem) 550px, (min-width: 48rem) 44vw, 92vw" />
          </figure>
        ))}
      </div>
      {images.length > 1 && (
        <div class="gallery-controls" data-gallery-controls hidden>
          <button type="button" class="gallery-previous" data-gallery-step="-1" aria-label={t.previousPhoto} data-i18n-aria-label="previousPhoto" aria-controls={`${id}-track`} disabled><Arrow /></button>
          <output class="gallery-counter" data-gallery-counter aria-live="polite">1 / {images.length}</output>
          <button type="button" data-gallery-step="1" aria-label={t.nextPhoto} data-i18n-aria-label="nextPhoto" aria-controls={`${id}-track`}><Arrow /></button>
        </div>
      )}
    </>
  ) : <MediaPlaceholder kind={kind} label={kind === 'store' ? t.storePhotoPending : t.productPhotoPending} enlargeLabel={t.enlargeImage} />}
</div>
