---
import type { ContactMethod } from '../lib/contact';
import WhatsApp from '../assets/icons/whatsapp.svg';
interface Props { kind: ContactMethod['kind'] }
const { kind } = Astro.props;
---
{kind === 'whatsapp' ? <WhatsApp class="contact-icon" width={22} height={22} aria-hidden="true" /> : (
  <svg class="contact-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    {kind === 'telephone' ? (
      <path d="m5.1 3.5 3-.5 1.8 4.2-1.8 1.9a14.5 14.5 0 0 0 6.8 6.8l1.9-1.8 4.2 1.8-.5 3c-.2 1.2-1.3 2-2.5 1.8C9.8 19.4 4.6 14.2 3.3 6c-.2-1.2.6-2.3 1.8-2.5Z" />
    ) : <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3.5 6 8.5 7 8.5-7" /></>}
  </svg>
)}
