---
import { company } from '../config/company';
import { contactMethods } from '../config/navigation';
import { copy } from '../i18n/copy';
import type { Locale } from '../i18n/routes';
import ContactAction from './ContactAction.astro';
import OwnerIcon from './OwnerIcon.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = copy(locale);
---
{contactMethods.length > 0 && (
  <div class="contact-panel" data-reveal data-reveal-order="1">
    <h3>{t.contactMethods}</h3>
    <ul class="contact-list">
      {contactMethods.map((method) => (
        <li class="contact-row">
          <p class="contact-label">{t.contactLabels[method.kind]}</p>
          <ContactAction method={method} locale={locale} />
        </li>
      ))}
    </ul>
    <div class="people">
      <h3>{t.owners}</h3>
      <ul class="owner-list">
        {company.owners.map(({ name, icon }) => <li><OwnerIcon kind={icon} /><span>{name}</span></li>)}
      </ul>
    </div>
  </div>
)}
