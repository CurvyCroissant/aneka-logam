---
import { contactMethods } from '../config/navigation';
---

{contactMethods.length > 0 && (
  <section aria-labelledby="contact-heading">
    <h2 id="contact-heading">Kontak resmi</h2>
    <dl class="contact-list">
      {contactMethods.map(({ label, value, href }) => (
        <div>
          <dt>{label}</dt>
          <dd><a href={href}>{value}</a></dd>
        </div>
      ))}
    </dl>
  </section>
)}
