---
import { getImage } from 'astro:assets';
import logo from '../assets/logo-no-bg.png';
import shareLogo from '../assets/logo.jpg';
import bootUrl from '../scripts/boot.js?url';
import montserratUrl from '@fontsource/montserrat/files/montserrat-latin-700-normal.woff2?url';
import { company } from '../config/company';
import { indexingEnabled } from '../config/site';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { copy } from '../i18n/copy';
import { locales, localeInfo, type Locale, type LocalizedPaths } from '../i18n/routes';
import '../styles/font.css';
import '../styles/global.css';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  paths: LocalizedPaths;
  noindex?: boolean;
  page?: 'home' | 'products';
}
const { locale, title, description, paths, noindex = false, page = 'home' } = Astro.props;
const titleKey = page === 'products' ? 'productsTitle' : 'homeTitle';
const descriptionKey = page === 'products' ? 'catalogDescription' : 'description';
const t = copy(locale);
const shouldIndex = indexingEnabled && Boolean(Astro.site) && !noindex;
const canonical = Astro.site && !noindex ? new URL(paths[locale], Astro.site) : undefined;
const favicon = await getImage({ src: logo, width: 48, height: 48, format: 'png' });
const shareImage = await getImage({ src: shareLogo, width: 1200, height: 1200, format: 'jpg', quality: 80 });
---
<!doctype html>
<html lang={localeInfo[locale].tag} data-page={noindex ? 'error' : page}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline src={bootUrl}></script>
    <meta name="description" content={description} data-i18n-content={descriptionKey} />
    <meta name="robots" content={shouldIndex ? 'index, follow' : 'noindex, nofollow'} />
    <title>{title}</title>
    <link rel="icon" type="image/png" href={favicon.src} />
    <link rel="preload" href={montserratUrl} as="font" type="font/woff2" crossorigin="anonymous" />
    {canonical && <link rel="canonical" href={canonical} />}
    {Astro.site && !noindex && (
      <>
        {locales.map((language) => <link rel="alternate" hreflang={localeInfo[language].tag} href={new URL(paths[language], Astro.site)} />)}
        <link rel="alternate" hreflang="x-default" href={new URL(paths.id, Astro.site)} />
      </>
    )}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={localeInfo[locale].og} />
    {locales.filter((language) => language !== locale).map((language) => <meta property="og:locale:alternate" content={localeInfo[language].og} />)}
    <meta property="og:site_name" content={company.name} />
    <meta property="og:title" content={title} data-i18n-content={titleKey} />
    <meta property="og:description" content={description} data-i18n-content={descriptionKey} />
    {Astro.site && <meta property="og:image" content={new URL(shareImage.src, Astro.site)} />}
    {Astro.site && <meta property="og:image:alt" content={`${company.name} logo`} />}
    {canonical && <meta property="og:url" content={canonical} />}
  </head>
  <body>
    <SiteHeader locale={locale} paths={paths} />
    <main id="main" tabindex="-1"><slot /></main>
    <SiteFooter locale={locale} />
    <p class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-copy-status></p>
    <span class="sr-only" id="new-tab-note" data-i18n="opensNewTab">{t.opensNewTab}</span>
    <dialog id="image-viewer" class="image-viewer" aria-label={t.imageViewer} data-i18n-aria-label="imageViewer" aria-describedby="image-viewer-help">
      <div class="image-viewer-scrim" data-image-scrim aria-hidden="true"></div>
      <div class="image-viewer-media" data-image-stage tabindex="0" role="img"></div>
      <p class="sr-only" id="image-viewer-help" data-i18n="closeImageHint">{t.closeImageHint}</p>
    </dialog>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
