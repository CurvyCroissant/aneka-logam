{
  "name": "aneka-logam",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Static company profile website for Aneka Logam.",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview",
    "verify": "npm run build:checked && wrangler deploy --dry-run",
    "deploy": "npm run verify && wrangler deploy",
    "test": "node --test",
    "check:build": "node scripts/check-build.mjs",
    "build:checked": "npm run test && npm run check && npm run build && npm run check:build"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource/montserrat": "5.3.0",
    "astro": "7.4.0",
    "parse5": "8.0.1",
    "typescript": "6.0.3",
    "wrangler": "4.151.1"
  }
}
